{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M3",
  "providers": {
    "openrouter": {
      "models": {
        "~deepseek/deepseek-flash-latest": {
          "variants": [
            { "id": "fast", "body": { "provider": { "order": ["baseten/fast"] } } }
          ]
        },
        "deepseek-flash-fast": {
          "modelID": "~deepseek/deepseek-flash-latest",
          "name": "DeepSeek Flash Latest (fast)",
          "family": "deepseek-flash",
          "type": "chat",
          "releaseDate": "2026-09-14",
          "body": { "provider": { "order": ["baseten/fast"] } },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "high", "max"]
            }
          },
          "limit": { "context": 1048576, "output": 943718 },
          "cost": {
            "input": 0.006,
            "output": 0.5,
            "cache": { "read": 0.005 }
          }
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/tool-prompt.md",
    "~/.config/opencode/secure-prompt.md",
    "~/.config/opencode/no-assumptions.md",
    "~/.config/opencode/hindsight.md"
  ],
  "agents": {
    "plan": {
      "system": "{file:./prompt/plan.txt}",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permissions": [
        { "action": "semble_*", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "semble_*", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "lsp": true,
  "permissions": [
    { "action": "codesearch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "review_inspect", "resource": "*", "effect": "deny" },
    { "action": "write_review_human_report", "resource": "*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" },
    { "action": "*", "resource": "~/.config/opencode/command/*", "effect": "ask" },
    { "action": "read", "resource": "~/.config/opencode/command/*", "effect": "allow" },
    { "action": "read", "resource": "~/.cache/opencode/packages/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/command/*", "effect": "allow" }
  ],
  "plugins": [
    "./plugins/openspec",
    "opencode-cockpit@0.11.2"
  ],
  "plugin": [
    "/home/stefan.hammer@canonical.com/.hindsight/coding-agents"
  ],
  "formatter": true,
  "mcp": {
    "servers": {
      "with-context": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "with-context-mcp"],
        "environment": {
          "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
          "OBSIDIAN_API_URL": "{env:OBSIDIAN_API_URL}",
          "OBSIDIAN_VAULT": "{env:OBSIDIAN_VAULT}",
          "PROJECT_BASE_PATH": "{env:PROJECT_BASE_PATH}"
        },
        "disabled": false
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp",
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "semble": {
        "type": "local",
        "command": ["uvx", "--from", "semble[mcp]", "semble"],
        "disabled": false
      },
      "MiniMax": {
        "type": "local",
        "command": ["uvx", "minimax-coding-plan-mcp", "-y"],
        "environment": {
          "MINIMAX_API_KEY": "{env:MINIMAX_API_KEY}",
          "MINIMAX_API_HOST": "https://api.minimax.io"
        },
        "disabled": false
      }
    }
  }
}
