{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "plugins": [
    "./herdr-tui-session.js",
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word",
    "single": true,
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "low",
    "grouping": "auto",
    "image_preview": true,
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal"
  },
  "prompt": {
    "image_preview": true
  }
}
