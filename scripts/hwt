#!/usr/bin/env bash
#
# hwt - make a git worktree checkout and open it as a Herdr space, the way the
# space menu's "New worktree..." does it.
#
# The same two steps Herdr's shipped `worktree` mod runs, with the same
# checkout location, so the new space nests under its repo in the spaces
# sidebar:
#
#   git worktree add ~/.herdr/worktrees/<repo>/<branch> ...
#   herdr-app do space.new --folder ~/.herdr/worktrees/<repo>/<branch>
#
# The difference: this runs from a shell or an agent that knows which terminal
# it is, so the repository is the folder that terminal sits in, not a guess
# made from the window's focus.

set -euo pipefail

# Checkouts go to <ROOT>/<repo>/<branch, slashes as dashes> (the mod's rule).
ROOT="${HOME}/.herdr/worktrees"

usage() {
	cat <<'EOF'
Usage: hwt [options] <branch>

Create a new git worktree checkout and open it as a Herdr space, exactly as
right-clicking a space and choosing "New worktree..." does. The checkout is
at ~/.herdr/worktrees/<repo>/<branch>, and the new space sits under its
repository in the spaces sidebar.

Options:
  -r, --repo <path>     branch this repository, whatever terminal you are in
  -b, --base <ref>      base commit for a new branch (default: HEAD)
  -s, --space <name|id> branch the repository of another space
  -a, --agent <kind>    start this agent in the new space, e.g. opencode
  -m, --model <ref>     with --agent opencode: create its session with this
                        model, as provider/model or provider/model#variant
  -t, --task <text>     its first message (with --agent; see below)
      --task-file <path> read that message from a file, for a long one
      --goal <text>     hold the session to an objective, and keep it working
                        until an independent reviewer says the objective is met
      --goal-file <path> read that objective from a file
      --argv <json>     start this argv instead, e.g. '["codex","--no-daemon"]'
                        Herdr's own agent arguments; not combined with --task
      --no-space        only create the checkout; leave the window alone
  -n, --dry-run         print the repository, checkout and command; make nothing
  -h, --help            show this text

The repository is the folder of what runs in the terminal running this: a
shell in front means the pane's folder, so a pane opened in a checkout
branches that checkout wherever you have cd'd; an agent or a program in front
means the folder it was started in, which may be a checkout other than the
pane's. A plain shell or a script has no Herdr terminal and uses the current
folder. --space takes it from another space instead: the terminal running
this if it is in that space, else that space's pane with the keyboard while
it is on screen.

The space you point at is not changed: the worktree gets a space of its own,
named after its branch.

An existing branch is checked out as it is; otherwise the branch is created
at --base. Nothing is deleted: remove a worktree with
`git -C <repo> worktree remove <path>` (after closing its space).

--task goes to the agent's own command line, the way Herdr starts it:
`opencode --prompt <text>`, and `<agent> <text>` for the others. Use
--argv when an agent wants different arguments than that. --task-file
reads the same message from a file, for a prompt with several paragraphs
and quotes in it that no sensible shell line would carry. When hwt creates
the session itself (--model or --goal), the task is sent to that session
instead, because opencode resubmits a --prompt that shares a command line
with --session in the first new tab it opens (anomalyco/opencode#63839).

--model pins the model of the opencode session. Its interactive command takes
no --model, so hwt creates the session on opencode's background server with
that model, and the tab opens it with --session. The --task message is sent to
that session, so the tab starts with it already there. Without --model
opencode creates a session on its configured default.

--goal gives the opencode session an objective and keeps it working until that
objective is met. OpenCode's own /goal command holds the session to it: a
reviewer judges the transcript against the objective on every idle turn, and
continues the work when the objective is not met yet. The reviewer trusts only
evidence it can see, so the objective must name the command to run and what it
prints, not the end state in your own words. A goal that cannot be met because
it needs a decision or a credential pauses; the person resumes it in that tab
with /goal resume. A goal is not durable across an opencode server restart.

Exit status is non-zero if the branch name is invalid, the checkout cannot be
made, or Herdr rejects the space. An existing checkout is left alone.
EOF
}

die() {
	echo "hwt: $*" >&2
	exit 1
}

# --- arguments ----------------------------------------------------------
branch=""
repo=""
base="HEAD"
space_want=""
agent=""
model=""
argv_json=""
argv_given=0
task=""
task_file=""
goal=""
goal_file=""
open_space=1
dry_run=0

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	-r | --repo)
		[[ $# -ge 2 ]] || die "--repo needs a path"
		repo="$2"
		shift 2
		;;
	-b | --base)
		[[ $# -ge 2 ]] || die "--base needs a ref"
		base="$2"
		shift 2
		;;
	-s | --space)
		[[ $# -ge 2 ]] || die "--space needs a name or id"
		space_want="$2"
		shift 2
		;;
	-a | --agent)
		[[ $# -ge 2 ]] || die "--agent needs an agent name"
		agent="$2"
		shift 2
		;;
	-m | --model)
		[[ $# -ge 2 ]] || die "--model needs a model reference"
		model="$2"
		shift 2
		;;
	--argv)
		[[ $# -ge 2 ]] || die "--argv needs JSON"
		argv_json="$2"
		argv_given=1
		shift 2
		;;
	-t | --task)
		[[ $# -ge 2 ]] || die "--task needs text"
		task="$2"
		shift 2
		;;
	--task-file)
		[[ $# -ge 2 ]] || die "--task-file needs a path"
		task_file="$2"
		shift 2
		;;
	--goal)
		[[ $# -ge 2 ]] || die "--goal needs text"
		goal="$2"
		shift 2
		;;
	--goal-file)
		[[ $# -ge 2 ]] || die "--goal-file needs a path"
		goal_file="$2"
		shift 2
		;;
	--no-space)
		open_space=0
		shift
		;;
	-n | --dry-run)
		dry_run=1
		shift
		;;
	--)
		shift
		break
		;;
	-*)
		die "unknown option '$1' (try --help)"
		;;
	*)
		[[ -z "$branch" ]] || die "expected one branch name, got '$branch' and '$1'"
		branch="$1"
		shift
		;;
	esac
done
if [[ -z "$branch" && $# -gt 0 ]]; then
	branch="$1"
	shift
fi
[[ $# -eq 0 ]] || die "expected one branch name, got '$branch' and '$1'"

# --- validate before touching anything ----------------------------------
[[ -n "$branch" ]] || {
	usage >&2
	die "expected a branch name"
}

command -v git >/dev/null 2>&1 || die "required command 'git' not found on PATH"

# git's own rules: rejects leading '-', '..', spaces, '~', '^', ':heavy' etc.
git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
	die "invalid branch name '$branch'"

[[ -z "$task" || -z "$argv_json" ]] ||
	die "--task and --argv cannot be combined; put the task in --argv yourself"

[[ -z "$task" || -z "$task_file" ]] || die "--task and --task-file cannot be combined"

[[ -z "$task_file" || -z "$argv_json" ]] ||
	die "--task-file and --argv cannot be combined; put the task in --argv yourself"

[[ -z "$task" || -n "$agent" ]] ||
	die "--task needs --agent (or write the arguments you want into --argv)"

[[ -z "$task_file" || -n "$agent" ]] ||
	die "--task-file needs --agent (or write the arguments you want into --argv)"

# A goal is set on an opencode session through opencode's own /goal command, so
# it needs that agent and nothing else.
[[ -z "$goal" || -z "$goal_file" ]] || die "--goal and --goal-file cannot be combined"
[[ -z "$goal" || "$agent" == opencode ]] ||
	die "--goal applies to --agent opencode only; another agent has no /goal"
[[ -z "$goal_file" || "$agent" == opencode ]] ||
	die "--goal-file applies to --agent opencode only; another agent has no /goal"
[[ -z "$goal" || -z "$argv_json" ]] ||
	die "--goal and --argv cannot be combined; the goal needs an opencode session"
[[ -z "$goal_file" || -z "$argv_json" ]] ||
	die "--goal-file and --argv cannot be combined; the goal needs an opencode session"
[[ -z "$goal" || $open_space -eq 1 ]] ||
	die "--goal is set on the session the new space opens; drop --no-space"
[[ -z "$goal_file" || $open_space -eq 1 ]] ||
	die "--goal-file is set on the session the new space opens; drop --no-space"

# opencode's goal command caps the objective at 4000 characters and refuses an
# empty one. Check it here, before a checkout is made.
if [[ -n "$goal_file" ]]; then
	[[ -r "$goal_file" ]] || die "cannot read '$goal_file'"
	goal="$(<"$goal_file")"
	[[ -n "${goal//[[:space:]]/}" ]] ||
		die "'$goal_file' is empty; there would be no objective to work toward"
fi
[[ ${#goal} -le 4000 ]] ||
	die "the goal objective is limited to 4000 characters (got ${#goal})"

# A file keeps a multi-paragraph prompt out of the shell's quoting.
if [[ -n "$task_file" ]]; then
	[[ -r "$task_file" ]] || die "cannot read '$task_file'"
	task="$(<"$task_file")"
	[[ -n "${task//[[:space:]]/}" ]] ||
		die "'$task_file' is empty; the agent would start with no task"
fi

[[ -z "$agent" || $argv_given -eq 0 ]] || die "--agent and --argv cannot be combined"

[[ -z "$model" || -n "$agent" ]] || die "--model needs --agent opencode"
[[ -z "$model" || "$agent" == opencode ]] ||
	die "--model applies to --agent opencode only; give another agent its own --argv"
[[ -z "$model" || "$model" =~ ^[A-Za-z0-9._~/-]+(#[A-Za-z0-9._-]+)?$ ]] ||
	die "invalid model reference '$model' (provider/model, optionally #variant)"

[[ -z "$model" || $open_space -eq 1 ]] ||
	die "--model is set on the session the new space opens; drop --no-space"

[[ -z "$repo" || -z "$space_want" ]] || die "--repo and --space cannot be combined"

[[ $open_space -eq 1 || -z "$space_want" ]] ||
	die "--no-space opens nothing, so --space makes no sense with it"

if [[ -n "$agent" ]]; then
	[[ "$agent" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
		die "invalid agent name '$agent' (letters, digits, '.', '_', '-' only)"
	command -v jq >/dev/null 2>&1 || die "required command 'jq' not found on PATH"
	# The agent's first message is its own CLI argument, as Herdr passes it
	# to `space.new --argv`: opencode reads a prompt only with --prompt.
	if [[ -n "$task" ]]; then
		case "$agent" in
		opencode) argv_json="$(jq -cn --arg a "$agent" --arg t "$task" '[$a, "--prompt", $t]')" ;;
		*) argv_json="$(jq -cn --arg a "$agent" --arg t "$task" '[$a, $t]')" ;;
		esac
	else
		argv_json="$(jq -cn --arg a "$agent" '[$a]')"
	fi
	# opencode's interactive command takes no --model either. The model is set
	# on the session, not in the client's config, so the tab must open a
	# session that already carries it: hwt creates that session below, once
	# the checkout exists, and folds its id into the argv as --session. A
	# private (`--standalone`) server keeps its pending question forms in its
	# own memory, out of the shared server — and out of the questions panel.
	# The same session.create gives hwt the id it needs to set a goal on it.
	if [[ -n "$model" || -n "$goal" ]]; then
		command -v opencode >/dev/null 2>&1 ||
			die "--model and --goal need 'opencode' on PATH to create the session"
	fi
fi

# --- which repository ---------------------------------------------------
# Where you are is what runs in the terminal running this. A shell in front
# means the pane's folder, so a checkout you opened stays the subject even
# after a cd. An agent in front is a program started in a checkout of its own,
# and that checkout is the subject: the pane it happens to sit in may belong
# to another repository. A plain shell or a script has no Herdr terminal to
# ask, and uses the current folder.
work_dir="$repo"
if [[ -z "$work_dir" ]]; then
	pane_cwd=""
	if [[ -n "${HC_TERMINAL_ID:-}" ]]; then
		command -v hc >/dev/null 2>&1 || die "required command 'hc' not found on PATH"
		command -v jq >/dev/null 2>&1 || die "required command 'jq' not found on PATH"
		term_json="$(hc get "$HC_TERMINAL_ID" 2>/dev/null)" || term_json=""
		if [[ -n "$term_json" ]]; then
			pane_cwd="$(jq -r '.cwd // empty' <<<"$term_json")" || pane_cwd=""
			fg_argv0="$(jq -r '.foreground.argv[0] // empty' <<<"$term_json")" || fg_argv0=""
			fg_cwd="$(jq -r '.foreground.cwd // empty' <<<"$term_json")" || fg_cwd=""
			case "${fg_argv0##*/}" in
			"" | bash | dash | ash | sh | zsh | fish | ksh | mksh | tcsh | csh | nu)
				work_dir="$pane_cwd"
				printf 'hwt: terminal %s, pane folder %s\n' \
					"$HC_TERMINAL_ID" "$work_dir" >&2
				;;
			*)
				work_dir="${fg_cwd:-$pane_cwd}"
				printf 'hwt: terminal %s, %s runs in %s\n' \
					"$HC_TERMINAL_ID" "${fg_argv0##*/}" "$work_dir" >&2
				;;
			esac
		fi
	fi
	work_dir="${work_dir:-${pane_cwd:-$PWD}}"
fi

# --space names another space to take the repository from.
if [[ -n "$space_want" ]]; then
	command -v herdr-app >/dev/null 2>&1 ||
		die "--space needs herdr-app on PATH; no checkout was made"
	command -v jq >/dev/null 2>&1 || die "required command 'jq' not found on PATH"

	all_spaces="$(herdr-app ls 2>/dev/null)" ||
		die "cannot read the Herdr window; no checkout was made"

	space_json="$(jq -cr --arg w "$space_want" '
		[.spaces[] | select(.id == $w or .name == $w)] |
		if length == 0 then "NONE" elif length > 1 then "AMBIGUOUS" else .[0] end' <<<"$all_spaces")" ||
		die "cannot read the spaces from the Herdr window; no checkout was made"
	[[ "$space_json" != "AMBIGUOUS" ]] ||
		die "'$space_want' names more than one space; use its id (nothing was made)"
	[[ "$space_json" != "NONE" ]] ||
		die "no space named '$space_want' (herdr-app ls lists them; nothing was made)"
	[[ -z "$(jq -r '.machine // empty' <<<"$space_json")" ]] ||
		die "space '$space_want' lives on another machine; only this computer's repositories can be branched here"

	space_id="$(jq -r '.id' <<<"$space_json")"
	status_json="$(herdr-app status 2>/dev/null)" ||
		die "cannot read the Herdr window; no checkout was made"

	# The terminal running this, if it is in that space; else the pane with the
	# keyboard, while that space is on screen. Herdr remembers the tab a space
	# was left on but not its pane, so a space that is neither is refused.
	space_terminal=""
	if [[ -n "${HC_TERMINAL_ID:-}" ]] && command -v hc >/dev/null 2>&1; then
		caller_info="$(hc get "$HC_TERMINAL_ID" 2>/dev/null)" || caller_info=""
		if [[ -n "$caller_info" &&
			"$(jq -r '.labels["herdr.space"] // empty' <<<"$caller_info")" == "$space_id" ]]; then
			space_terminal="$HC_TERMINAL_ID"
		fi
	fi
	if [[ -z "$space_terminal" &&
		"$(jq -r '.space // empty' <<<"$status_json")" == "$space_id" ]]; then
		focused_pane="$(jq -r '.focused_pane // empty' <<<"$status_json")"
		space_terminal="$(jq -r --arg p "$focused_pane" '
			.tabs[].terminals[] | select(.pane == $p) | .terminal' <<<"$space_json")"
	fi
	[[ -n "$space_terminal" ]] ||
		die "space '$space_want' is not on screen and this terminal is not in it; show that space, or name its repository with --repo <path>"

	command -v hc >/dev/null 2>&1 || die "required command 'hc' not found on PATH"
	work_dir="$(hc get "$space_terminal" 2>/dev/null | jq -r '.cwd // empty')" || work_dir=""
	[[ -n "$work_dir" ]] ||
		die "cannot read the folder of terminal '$space_terminal', the one to use from space '$space_want'"
	git -C "$work_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
		die "terminal '$space_terminal' in space '$space_want' is in '$work_dir', which is not in a git repository; name one with --repo <path>"
	printf 'hwt: space %s, terminal %s (%s)\n' "$space_want" "$space_terminal" "$work_dir" >&2
fi

# The main checkout: `git worktree list --porcelain` lists it first. The repo
# name and the checkout location both come from it, never from a linked
# worktree's own folder (which is named after the branch).
main_root="$(git -C "$work_dir" worktree list --porcelain 2>/dev/null |
	awk '/^worktree /{print substr($0, 10); exit}')" || main_root=""
[[ -n "$main_root" ]] ||
	die "'$work_dir' is not in a git repository (use --repo <path>)"

repo_name="$(basename -- "$main_root")"
slug="$(printf '%s' "$branch" | sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
[[ -n "$slug" ]] || die "branch '$branch' has no characters usable in a folder name"
path="${ROOT}/${repo_name}/${slug}"

[[ ! -e "$path" ]] || die "checkout already exists: $path"

new_branch=0
if ! git -C "$main_root" show-ref --verify --quiet "refs/heads/$branch"; then
	new_branch=1
	git -C "$main_root" rev-parse --verify --quiet "${base}^{commit}" >/dev/null ||
		die "'$base' is not a commit in $main_root"
fi

if [[ $dry_run -eq 1 ]]; then
	printf 'hwt: repository %s\n' "$main_root"
	printf 'hwt: checkout   %s (%s)\n' "$path" \
		"$([[ $new_branch -eq 1 ]] && printf 'new branch %s from %s' "$branch" "$base" ||
			printf 'existing branch %s' "$branch")"
	preview_json="$argv_json"
	if [[ -n "$model" || -n "$goal" ]]; then
		if [[ -n "$model" ]]; then
			printf 'hwt: session    session.create at %s with %s\n' "$path" "$model"
		else
			printf 'hwt: session    session.create at %s with the configured default\n' "$path"
		fi
		if [[ -n "$task" ]]; then
			# The task is a message to the session, not an argument that
			# would ride on the same command line as --session.
			preview_json="$(jq -cn --argjson a "$argv_json" '[$a[0], "--session", "<new>"]')"
			printf 'hwt: task       session.prompt on that session, %s characters\n' "${#task}"
		else
			preview_json="$(jq -cn --argjson a "$argv_json" '[$a[0], "--session", "<new>"] + $a[1:]')"
		fi
	fi
	if [[ -n "$goal" ]]; then
		printf 'hwt: goal       %s\n' "$goal"
	fi
	printf 'hwt: herdr      %s\n' "$([[ -n "$preview_json" ]] &&
		printf 'space.new --folder %s --argv %s' "$path" "$preview_json" ||
		printf 'space.new --folder %s' "$path")"
	exit 0
fi

# --- create the checkout ------------------------------------------------
if [[ $new_branch -eq 1 ]]; then
	git -C "$main_root" worktree add -b "$branch" "$path" "$base" ||
		die "git worktree add failed for new branch '$branch'"
else
	git -C "$main_root" worktree add "$path" "$branch" ||
		die "git worktree add failed for existing branch '$branch'"
fi

if [[ $open_space -eq 0 ]]; then
	echo "hwt: $branch -> $path" >&2
	exit 0
fi

# --- open it in Herdr ---------------------------------------------------
if ! command -v herdr-app >/dev/null 2>&1 || ! herdr-app status >/dev/null 2>&1; then
	echo "hwt: warning: no running Herdr window; checkout left at $path" >&2
	exit 0
fi

# The model and the goal are both session properties. Create the session on
# opencode's background server — never a private one — so every surface sees the
# same session and the tab opens it with --session. A goal needs that id too,
# because it is set on the session through opencode's own /goal command, which
# is not something a prompt can do.
if [[ -n "$model" || -n "$goal" ]]; then
	if [[ -n "$model" ]]; then
		provider="${model%%/*}"
		rest="${model#*/}"
		if [[ "$rest" == *"#"* ]]; then
			model_id="${rest%%#*}"
			variant="${rest#*#}"
		else
			model_id="$rest"
			variant=""
		fi
		session_payload="$(jq -cn --arg p "$provider" --arg i "$model_id" --arg v "$variant" --arg d "$path" '
			{ model: ({providerID: $p, id: $i} + (if $v == "" then {} else {variant: $v} end)),
			  location: {directory: $d} }')"
	else
		# No model given: let the server apply its configured default, and
		# keep only what the goal needs, the session and its directory.
		session_payload="$(jq -cn --arg d "$path" '{ location: {directory: $d} }')"
	fi
	if ! session_json="$(opencode api session.create --data "$session_payload" 2>&1)"; then
		die "worktree created at $path, but the OpenCode session could not be created: $session_json"
	fi
	session_id="$(jq -r '.data.id // empty' <<<"$session_json" 2>/dev/null)" || session_id=""
	[[ -n "$session_id" ]] ||
		die "worktree created at $path, but the OpenCode session could not be read: $session_json"
	# --prompt must not share a command line with --session: opencode 2.3.0
	# keeps that text past startup and submits it again in the first tab
	# opened afterwards (anomalyco/opencode#63839), so a stray tab would start
	# a second agent on the same brief. The task goes to the session below.
	if [[ -n "$task" ]]; then
		argv_json="$(jq -c --arg s "$session_id" '[.[0], "--session", $s]' <<<"$argv_json")"
	else
		argv_json="$(jq -c --arg s "$session_id" '[.[0], "--session", $s] + .[1:]' <<<"$argv_json")"
	fi
fi

# Set the goal on the session. This is opencode's own /goal command, reached
# through the session command API: a prompt that merely starts with "/goal" is
# read as prose, so the command has to be invoked as one. The reviewer it runs
# on every idle turn judges the transcript against the objective and continues
# the work when the objective is not met yet.
if [[ -n "$goal" ]]; then
	goal_payload="$(jq -cn --arg t "$goal" '{ name: "goal", text: $t }')"
	if ! goal_json="$(opencode api session.command --param sessionID="$session_id" \
		--data "$goal_payload" 2>&1)"; then
		die "worktree created at $path, but the goal could not be set on session $session_id: $goal_json"
	fi
fi

# Send the task as the session's first user message, now that the session
# exists. Nothing is attached yet, so this starts the turn on the server; the
# tab opens that same session and shows it running. A goal's kickoff is a
# synthetic notice and not a user message, so this lands as the first one, as
# it does when the tab submits it.
if [[ -n "$task" ]]; then
	task_payload="$(jq -cn --arg t "$task" '{ text: $t }')"
	if ! task_json="$(opencode api session.prompt --param sessionID="$session_id" \
		--data "$task_payload" 2>&1)"; then
		die "worktree created at $path, but the task could not be sent to session $session_id: $task_json"
	fi
fi

space_args=(do space.new --folder "$path")
[[ -n "$argv_json" ]] && space_args+=(--argv "$argv_json")

herdr-app "${space_args[@]}" ||
	die "worktree created at $path, but Herdr rejected the space"

echo "hwt: $branch -> $path" >&2
